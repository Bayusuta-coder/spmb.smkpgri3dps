# Copy file ini jadi `.env` lalu isi nilainya.
# `.env` sudah masuk .gitignore — JANGAN commit file `.env` asli.

# ─── Database ──────────────────────────────────────────────────────────────
# Untuk `npm run dev` native di host (Windows/Linux), host = `localhost`.
# Saat backend di-container-kan, host = `db` (sesuai docker-compose service name).
DATABASE_URL=postgresql://spmb:CHANGE_ME@localhost:5432/spmb?schema=public

# ─── Storage ───────────────────────────────────────────────────────────────
# Path relatif ke CWD (folder backend/). Wajib writable.
UPLOADS_DIR=uploads/spmb

# ─── Seed: Superadmin ─────────────────────────────────────────────────────
# WAJIB diisi sebelum `npm run seed`. Minimal 12 karakter.
# Password ini TIDAK BOLEH punya default hardcoded — demi keamanan data siswa.
# Contoh: SEED_ADMIN_PASSWORD=GantiDenganPasswordKuat123!
SEED_ADMIN_PASSWORD=

# Opsional — default ke `superadmin@smk-pgri3dps.sch.id` kalau kosong.
SEED_ADMIN_EMAIL=

# ─── Auth (JWT) ────────────────────────────────────────────────────────────
# WAJIB diisi di production. Generate random 32+ char hex:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Di dev boleh pendek, di production HARUS random & tidak masuk source control.
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET

# Default: 8h. Format: https://github.com/vercel/ms
JWT_EXPIRES_IN=8h

# ─── Frontend origins (untuk CORS + link email) ────────────────────────────
# Dipakai untuk allowlist CORS backend dan untuk compose link di email
# (mis. link reset password yang di-email ke admin).
FRONTEND_USER_ORIGIN=http://localhost:5173
FRONTEND_ADMIN_ORIGIN=http://localhost:5174

# ─── SMTP (untuk kirim email notifikasi + reset password) ──────────────────
# Kosongkan semua = email cuma di-log ke console backend (mode dev).
# Production: pakai SMTP Hostinger (smtp.hostinger.com:465) atau provider lain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Default kalau kosong: no-reply@smk-pgri3dps.sch.id
SMTP_FROM=

# ─── Password reset (self-service via email) ────────────────────────────────
# TTL token reset dalam menit. Default 30. Makin pendek = makin aman,
# tapi user harus segera klik link. Jangan lebih dari 60 menit.
PASSWORD_RESET_TOKEN_TTL=30

# ─── Server ────────────────────────────────────────────────────────────────
BACKEND_PORT=4000

# ─── WhatsApp (Meta WhatsApp Cloud API) ────────────────────────────────────
# Provider WhatsApp: Meta WhatsApp Cloud API (Graph API v20.0).
#
# Untuk setup production:
#   1. Buka https://developers.facebook.com/ → WhatsApp → Getting Started
#   2. Catat "Phone number ID" dari Meta Business Suite → WHATSAPP_PHONE_NUMBER_ID
#   3. Generate system user permanent token → WHATSAPP_ACCESS_TOKEN
#   4. Pastikan template OTP sudah di-approve di Meta Business Manager.
#      Template body harus punya SATU placeholder {{1}} untuk kode OTP.
#   5. Set WHATSAPP_OTP_TEMPLATE = nama template yang sudah di-approve.
#   6. Set WHATSAPP_OTP_LANG = kode bahasa template (mis. 'id', 'en').
#
# Validasi saat boot: kalau salah satu field wajib kosong, backend akan log
# error dan request OTP akan ditolak (HTTP 500, tanpa kode OTP).
#
# Alias backward-compat (tetap dibaca, preferensi nama canonical di awal):
#   WHATSAPP_PHONE_ID    ← WHATSAPP_PHONE_NUMBER_ID
#   WHATSAPP_API_TOKEN   ← WHATSAPP_ACCESS_TOKEN
#
# DILARANG hardcode credential di source code. Token WAJIB via env.
# DILARANG log token / OTP / full request body.

WHATSAPP_PROVIDER=cloud

# Base URL Meta Graph API. Default v20.0.
WHATSAPP_API_URL=https://graph.facebook.com/v20.0

# Phone Number ID dari Meta Business Suite. WAJIB diisi.
WHATSAPP_PHONE_NUMBER_ID=

# System user permanent access token. WAJIB diisi. Jangan di-commit.
WHATSAPP_ACCESS_TOKEN=

# Nama template OTP yang sudah di-approve Meta. WAJIB diisi.
WHATSAPP_OTP_TEMPLATE=otp_verifikasi

# Kode bahasa template OTP. WAJIB diisi. Mis. 'id', 'en', 'en_US'.
WHATSAPP_OTP_LANG=id

# ─── Laporan Harian (cron job) ─────────────────────────────────────────────
# Escape hatch total: kalau di-set 'false', scheduler & trigger manual tidak
# kirim ke channel manapun (Excel file tetap di-generate untuk arsip).
LAPORAN_HARIAN_ENABLED=true

# Fallback recipients kalau setting `laporan_harian.email.recipients` kosong
# di DB. Dipisah koma, tanpa spasi. Mis. admin1@x.com,admin2@y.com
LAPORAN_EMAIL_RECIPIENTS=

# ─── WhatsApp OTP tuning (override via settings DB) ───────────────────────
# Semua nilai ini default aman. Bisa di-tweak via Settings page tanpa restart
# (lihat menu "Pengaturan Laporan"). Tapi bisa juga di-pin di sini sebagai
# fallback kalau DB setting kosong.
WHATSAPP_OTP_TTL_SECONDS=300
WHATSAPP_OTP_MAX_ATTEMPTS=5
WHATSAPP_OTP_RESEND_COOLDOWN_SECONDS=60

# ─── Fonnte (untuk notifikasi rekap harian via WhatsApp) ─────────────────
# Provider INDEPENDEN dari Meta WhatsApp Cloud API di atas — Fonnte dipakai
# khusus untuk kirim Excel rekap harian ke user panitia, bukan untuk OTP.
#
# Cara setup:
#   1. Buka https://fonnte.com → daftarkan device, scan QR WhatsApp
#   2. Ambil token dari menu "Connect" → "Token"
#   3. Paste ke FONNTE_TOKEN di bawah (WAJIB env, TIDAK BOLEH hardcode)
#
# Kosongkan = channel Fonnte di-skip. File Excel rekap harian tetap
# di-generate ke disk untuk arsip, tapi tidak ada pesan WA terkirim.
# Trigger manual dari UI Pengaturan Laporan tetap jalan dan return hasil
# (dengan fonnte.skipped = jumlah recipient).
#
# DILARANG log token / full nomor telepon / full body response Fonnte.
FONNTE_TOKEN=7KWJQKfoWs9bhxK9K8hh

# Optional override base URL. Default sesuai dokumentasi resmi Fonnte.
FONNTE_BASE_URL=https://api.fonnte.com
