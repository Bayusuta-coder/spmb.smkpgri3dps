# ============================================================================
# SPMB SMK PGRI 3 Denpasar — environment variables
# Salin file ini ke `.env` dan isi nilai sesuai kebutuhan:
#   cp .env.example .env
# ============================================================================

# ---- Database --------------------------------------------------------------
POSTGRES_DB=spmb
POSTGRES_USER=spmb
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://spmb:change-me@db:5432/spmb?schema=public

# ---- Backend ---------------------------------------------------------------
BACKEND_PORT=4000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h

# Asal CORS yang diizinkan (frontend dev default)
FRONTEND_USER_ORIGIN=http://localhost:5173
FRONTEND_ADMIN_ORIGIN=http://localhost:5174

# ---- Seed akun superadmin (dibuat saat seed pertama kali) -----------------
SEED_ADMIN_EMAIL=superadmin@smk-pgri3dps.sch.id
SEED_ADMIN_PASSWORD=change-this-password

# ---- SMTP (untuk email otomatis) -------------------------------------------
# Jika kosong, sistem hanya akan LOG email ke console (cukup untuk development).
# Untuk production, isi dengan kredensial SMTP server sekolah / pihak ketiga.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@smk-pgri3dps.sch.id

# ---- Adminer (GUI database di browser) -------------------------------------
ADMINER_PORT=8080
